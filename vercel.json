{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "https://casa.erica-hu.com",
      "permanent": false
    },
    {
      "source": "/casa",
      "missing": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "https://casa.erica-hu.com",
      "permanent": false
    },
    {
      "source": "/casa/:path*",
      "missing": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "https://casa.erica-hu.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "/casa"
    },
    {
      "source": "/",
      "destination": "/home"
    }
  ]
}
