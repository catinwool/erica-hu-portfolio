{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/casa",
      "missing": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "https://casa.erica-hu.com",
      "permanent": false
    },
    {
      "source": "/casa/:path*",
      "missing": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "https://casa.erica-hu.com",
      "permanent": false
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "dest": "/casa/index.html",
      "override": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "/casa/index.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    }
  ]
}
