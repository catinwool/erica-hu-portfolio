{
  "cleanUrls": true,
  "functions": {
    "api/bookmark.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/|art/|casa(?:/|$)).+)",
      "has": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "https://casa.erica-hu.com",
      "permanent": false
    },
    {
      "source": "/casa",
      "missing": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "https://casa.erica-hu.com",
      "permanent": false
    },
    {
      "source": "/casa/:path*",
      "missing": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "https://casa.erica-hu.com",
      "permanent": false
    },
    {
      "source": "/:path((?!api/|art/|bookmark(?:/|$)|favicon\\.svg$).+)",
      "has": [
        {
          "type": "host",
          "value": "bookmark.erica-hu.com"
        }
      ],
      "destination": "https://bookmark.erica-hu.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "casa.erica-hu.com"
        }
      ],
      "destination": "/casa"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bookmark.erica-hu.com"
        }
      ],
      "destination": "/bookmark"
    },
    {
      "source": "/",
      "destination": "/home"
    }
  ]
}
